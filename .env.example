NODE_ENV=production
PORT=4100
TZ=Asia/Tashkent
TRUST_PROXY=false

# This must be a separate database from the Yamaha mini app database.
MONGO_URI=mongodb://127.0.0.1:27017/yamaha_uzum
SOURCE_MONGO_URI=

UZUM_PUBG_SERVICE_IDS=7814652
UZUM_PUBG_LOGIN=uzumloginforpubg
UZUM_PUBG_PASSWORD=change-me
UZUM_PUBG_CONFIRM_WAIT_MS=125000
UZUM_PUBG_CONFIRM_CHECK_INTERVAL_MS=500

GW_API_URL=https://api.sonofutred.com
